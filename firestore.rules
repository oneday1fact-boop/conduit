rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/closedAccounts/$(uid));
    }
    function word(value) {
      return value == null || (value is string && value.size() <= 32 && value.matches('^[A-Z]+$'));
    }
    function progress(data, version) {
      let required = ['schemaVersion','puzzleId','slots','elapsed','hintsUsed','rewardedHintUsed','completed','modifiedAt','updatedAt'];
      return data.keys().hasAll(required)
        && data.keys().hasOnly(version == 1 ? required : required.concat(['dailyWin']))
        && data.schemaVersion == version
        && (version == 1 || data.dailyWin is bool)
        && data.puzzleId is string && data.puzzleId.size() > 0 && data.puzzleId.size() <= 160
        && data.slots is list && data.slots.size() == 3
        && word(data.slots[0]) && word(data.slots[1]) && word(data.slots[2])
        && (data.slots[0] == null || data.slots[0] != data.slots[1])
        && (data.slots[0] == null || data.slots[0] != data.slots[2])
        && (data.slots[1] == null || data.slots[1] != data.slots[2])
        && (!data.completed || (data.slots[0] != null && data.slots[1] != null && data.slots[2] != null))
        && data.elapsed is number && data.elapsed >= 0 && data.elapsed <= 31536000
        && data.hintsUsed is int && data.hintsUsed >= 0 && data.hintsUsed <= 2
        && data.rewardedHintUsed is bool && data.completed is bool
        && data.modifiedAt is int && data.modifiedAt >= 0 && data.modifiedAt <= 4102444800000
        && data.updatedAt == request.time;
    }
    // Preserve the existing schema-1 progress and preference paths and validations.
    match /users/{uid}/progress/{key} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && key.matches('^(daily:[0-9]{4}-[0-9]{2}-[0-9]{2}|practice:[a-zA-Z0-9_-]{1,180})$') && progress(request.resource.data, 1);
      allow update: if owner(uid) && progress(request.resource.data, 1)
        && (!resource.data.completed || request.resource.data.completed)
        && request.resource.data.modifiedAt >= resource.data.modifiedAt;
    }
    match /users/{uid}/progressV2/{key} {
      allow read: if owner(uid);
      allow create: if owner(uid) && key.matches('^(daily:[0-9]{4}-[0-9]{2}-[0-9]{2}|practice:[a-zA-Z0-9_-]{1,180})$') && progress(request.resource.data, 2);
      allow update: if owner(uid) && progress(request.resource.data, 2)
        && (!resource.data.completed || request.resource.data.completed)
        && request.resource.data.modifiedAt >= resource.data.modifiedAt;
      allow delete: if false;
    }
    function preferences(data) {
      return data.keys().hasAll(['schemaVersion','theme','sound','music','haptics','tutorialSeen','modifiedAt','updatedAt'])
        && data.keys().hasOnly(['schemaVersion','theme','sound','music','haptics','tutorialSeen','modifiedAt','updatedAt'])
        && data.schemaVersion == 1 && data.theme in ['light','dark']
        && data.sound is bool && data.music is bool && data.haptics is bool && data.tutorialSeen is bool
        && data.modifiedAt is int && data.modifiedAt >= 0 && data.modifiedAt <= 4102444800000
        && data.updatedAt == request.time;
    }
    match /users/{uid}/settings/preferences {
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && preferences(request.resource.data);
      allow update: if owner(uid) && preferences(request.resource.data)
        && request.resource.data.modifiedAt >= resource.data.modifiedAt;
    }
    match /users/{uid}/private/entitlement { allow read: if owner(uid); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
